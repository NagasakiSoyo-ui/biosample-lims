# Production environment variables (set these in Vercel → Project → Settings → Environment Variables)
# DO NOT commit real values — this file is just a reference shape.

# Supabase Postgres — Connection pooling (Transaction mode), with pgbouncer hints
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase Postgres — Direct connection (used by `prisma db push` / migrate)
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:YOUR-DB-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# 32+ byte random string. Generate locally with `openssl rand -base64 32` or `npx auth secret`.
# Must be different from the dev secret in .env.
NEXTAUTH_SECRET="REPLACE-WITH-32-BYTE-RANDOM-STRING"

# Public URL of the deployed site. After first deploy, copy the Vercel URL here and redeploy.
NEXTAUTH_URL="https://biosample-lims.vercel.app"
