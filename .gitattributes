# Force LF for files that are read by Linux containers / build pipelines.
# Without this, a fresh git checkout on Windows would convert these to CRLF
# and the container would fail with "bad interpreter: /bin/sh\r".

*.sh             text eol=lf
Dockerfile       text eol=lf
.dockerignore    text eol=lf
*.yml            text eol=lf
*.yaml           text eol=lf
*.conf           text eol=lf
