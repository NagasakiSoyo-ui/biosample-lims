# Copy to .env.local for development.
# In production (Vercel), set these in the project's Environment Variables.

# --- Database -----------------------------------------------------------------
# Dev (SQLite, default for Phase 1):
DATABASE_URL="file:./dev.db"
# Prod (Supabase Postgres) — switch provider in prisma/schema.prisma to "postgresql":
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=public"

# --- NextAuth (Auth.js v5) ----------------------------------------------------
# Generate with: `npx auth secret` or `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-me-with-a-32+-byte-random-string"

# Public URL of the deployed app. Use http://localhost:3000 for local dev.
NEXTAUTH_URL="http://localhost:3000"
